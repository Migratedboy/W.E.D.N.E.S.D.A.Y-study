# ============================================================
# W.E.D.N.E.S.D.A.Y STUDY — environment template
# Copy to .env and fill in. Never commit .env.
# ============================================================

# ---------- Required ----------
# Supabase project settings -> API.
# SUPABASE_SERVICE_ROLE_KEY is the **service role** key (NOT the anon key).
# It bypasses Row Level Security and must never reach the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI provider (optional; app falls back to offline tutor replies) ----------
# Any OpenAI-compatible /chat/completions endpoint works.
AI_API_KEY=
AI_API_BASE_URL=https://integrate.api.nvidia.com/v1
# Comma-separated fallback chain, tried in order.
# AI_MODELS=meta/llama-3.1-70b-instruct,mistralai/mixtral-8x7b-instruct-v0.1

# ---------- Email (optional; verification codes print to console if unset) ----------
# Use a Gmail App Password, not your account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------- YouTube search (optional; powers "AI Learning Resources") ----------
YOUTUBE_API_KEY=

# ---------- Server ----------
PORT=4174
# Bind address. 0.0.0.0 is required for Docker/containers/PaaS.
HOST=0.0.0.0
# Set to "production" to hide provider error details from clients.
NODE_ENV=development
# Comma-separated list of allowed browser origins.
# ALLOWED_ORIGINS=http://localhost:4174,https://study.example.com
# Set to 1 only when running behind a reverse proxy you control (trusts X-Forwarded-For).
TRUST_PROXY=0
# Set to 1 when TLS terminates at a proxy (adds Secure to cookies).
FORCE_SECURE_COOKIE=0

# ---------- AI request timeout tuning (milliseconds) ----------
# AI_TIMEOUT_BASE_MS=20000
# AI_TIMEOUT_PER_TOKEN_MS=30
# AI_TIMEOUT_FLOOR_MS=30000
# AI_TIMEOUT_CEILING_MS=120000
# AI_HISTORY_CHAR_BUDGET=12000
